    "build:windows": "npm run build && node platforms/windows/build-desktop.mjs --package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALT34555/qianlinchaguan.git"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.19.1",
    "@types/three": "^0.186.0",
    "electron": "^44.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "main": "platforms/windows/desktop.cjs"
}
